@@ -0,0 +1,225 @@
+"""RDMA codec correctness and graph replay; run with torchrun (two ranks).
+
+Uses small buffers and synthetic expert outputs, without loading model weights.
+Run on a PCIe host with NVSHMEM_IB_TRAFFIC_CLASS set for its RoCE network.
+"""
+
+import argparse
+import os
+
+import torch
+import torch.distributed as dist
+
+from deep_ep import Buffer
+
+
+def fp8_roundtrip(x):
+    groups = x.float().reshape(*x.shape[:-1], x.shape[-1] // 128, 128)
+    scales = groups.abs().amax(-1).clamp(min=1.0e-12) / 448.0
+    values = (groups / scales.unsqueeze(-1)).to(torch.float8_e4m3fn).float()
+    return (values * scales.unsqueeze(-1)).reshape_as(x)
+
+
+def nvfp4_reference(x):
+    groups = x.float().reshape(x.shape[0], x.shape[1] // 16, 16)
+    global_scale = x.float().abs().amax(-1).clamp(min=1.0e-12) / (6.0 * 448.0)
+    scales = (groups.abs().amax(-1) / (6.0 * global_scale[:, None])).clamp(max=448)
+    scales = scales.to(torch.float8_e4m3fn).float() * global_scale[:, None]
+    scaled = groups / scales.clamp(min=1.0e-30).unsqueeze(-1)
+    lut = torch.tensor([0, 0.5, 1, 1.5, 2, 3, 4, 6], device=x.device)
+    distances = (scaled.abs().unsqueeze(-1) - lut).abs()
+    indices = distances.argmin(-1)
+    adjacent = (indices + 1).clamp(max=7)
+    ties = distances.gather(-1, indices.unsqueeze(-1)) == distances.gather(
+        -1, adjacent.unsqueeze(-1)
+    )
+    indices = torch.where(ties.squeeze(-1) & (adjacent % 2 == 0), adjacent, indices)
+    values = lut[indices] * scaled.sign() * scales.unsqueeze(-1)
+    return values.reshape_as(x).to(torch.bfloat16)
+
+
+def decode_nvfp4(payload, lut):
+    data, scales, globals_ = payload
+    codes = torch.stack((data & 15, data >> 4), -1).flatten(-2).long()
+    values = lut[codes].reshape(*scales.shape, 16)
+    return (
+        (values * scales.float().unsqueeze(-1) * globals_[..., None, None])
+        .flatten(-2)
+        .to(torch.bfloat16)
+    )
+
+
+def reference(x, ids, weights, dispatch, combine):
+    received = (
+        nvfp4_reference(x)
+        if dispatch == "nvfp4"
+        else (fp8_roundtrip(x).to(torch.bfloat16) if dispatch == "fp8" else x)
+    )
+    outputs = []
+    for i in range(ids.shape[1]):
+        coefficient = ((ids[:, i] % 5).float() + 1) * 0.125
+        value = (received.float() * coefficient[:, None]).to(torch.bfloat16)
+        if combine == "fp8":
+            value = fp8_roundtrip(value)
+        outputs.append(value.float() * weights[:, i : i + 1])
+    return torch.stack(outputs).sum(0).to(torch.bfloat16)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--hidden", type=int, default=2048)
+    parser.add_argument("--experts", type=int, default=32)
+    parser.add_argument("--combine-dtypes", default="bf16,fp8")
+    args = parser.parse_args()
+    local_rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(local_rank)
+    dist.init_process_group("gloo")
+    rank, ranks = dist.get_rank(), dist.get_world_size()
+    assert Buffer.wire_format_version >= 1
+    capacity, tokens, topk = 8, 4, 4
+    local_experts = args.experts // ranks
+    # Match this small test capacity; IBGDA requires a minimum depth of 128.
+    required_depth = max(128, 2 * (capacity + 1))
+    depth = 1 << (required_depth - 1).bit_length()
+    os.environ.setdefault("NVSHMEM_QP_DEPTH", str(depth))
+    assert int(os.environ["NVSHMEM_QP_DEPTH"]) >= required_depth
+    rdma_bytes = Buffer.get_low_latency_rdma_size_hint(
+        capacity, args.hidden, ranks, args.experts
+    )
+    buffer = Buffer(
+        dist.group.WORLD,
+        0,
+        rdma_bytes,
+        low_latency_mode=True,
+        num_qps_per_rank=local_experts,
+        allow_nvlink_for_low_latency_mode=False,
+        allow_mnnvl=False,
+    )
+    x = (
+        (
+            torch.arange(tokens * args.hidden, device="cuda")
+            .float()
+            .reshape(tokens, args.hidden)
+            % 51
+            - 25
+        )
+        * (rank + 1)
+        * 0.03125
+    ).to(torch.bfloat16)
+    x.mul_(torch.tensor([0.0, 0.03125, 1.0, 64.0], device="cuda")[:, None])
+    ids = (
+        (
+            torch.arange(tokens, device="cuda")[:, None] * 7
+            + torch.arange(topk, device="cuda")[None, :] * 5
+            + rank
+        )
+        % args.experts
+    ).to(torch.int64)
+    weights = (
+        torch.tensor([0.1, 0.2, 0.3, 0.4], device="cuda")
+        .expand(tokens, topk)
+        .contiguous()
+    )
+    coefficients = (
+        (torch.arange(local_experts, device="cuda") + rank * local_experts) % 5 + 1
+    ).float()[:, None, None] * 0.125
+    decode_lut = torch.tensor(
+        [0, 0.5, 1, 1.5, 2, 3, 4, 6, 0, -0.5, -1, -1.5, -2, -3, -4, -6], device="cuda"
+    )
+    base_x = x.clone()
+
+    for dispatch in ("bf16", "fp8", "nvfp4"):
+        for combine in args.combine_dtypes.split(","):
+            x.copy_(base_x)
+
+            def step():
+                received, count, handle, event, hook = buffer.low_latency_dispatch(
+                    x,
+                    ids,
+                    capacity,
+                    args.experts,
+                    use_fp8=dispatch == "fp8",
+                    use_nvfp4=dispatch == "nvfp4",
+                    return_recv_hook=True,
+                )
+                hook()
+                if dispatch == "nvfp4":
+                    received = decode_nvfp4(received, decode_lut)
+                elif dispatch == "fp8":
+                    data, scales = received
+                    received = (
+                        (
+                            data.float().reshape(
+                                local_experts, ranks * capacity, args.hidden // 128, 128
+                            )
+                            * scales.unsqueeze(-1)
+                        )
+                        .flatten(-2)
+                        .to(torch.bfloat16)
+                    )
+                expert_output = (received.float() * coefficients).to(torch.bfloat16)
+                output, event, hook = buffer.low_latency_combine(
+                    expert_output,
+                    ids,
+                    weights,
+                    handle,
+                    use_fp8=combine == "fp8",
+                    use_logfmt=combine == "logfmt",
+                    return_recv_hook=True,
+                )
+                hook()
+                return output
+
+            actual = step()
+            torch.testing.assert_close(
+                actual,
+                reference(x, ids, weights, dispatch, combine),
+                rtol=0.004,
+                atol=0.003,
+            )
+            # Warm native and Torch kernels before recording allocations/communication.
+            step()
+            dist.barrier()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                captured = step()
+            for multiplier in (-0.75, 0.125):
+                x.mul_(multiplier)
+                graph.replay()
+                torch.cuda.synchronize()
+                torch.testing.assert_close(
+                    captured,
+                    reference(x, ids, weights, dispatch, combine),
+                    rtol=0.004,
+                    atol=0.003,
+                )
+            # An idle rank still participates, sends no routes, and receives peer tokens.
+            if rank == 0:
+                saved = x
+                x = x[:0]
+                ids_saved, weights_saved = ids, weights
+                ids, weights = ids[:0], weights[:0]
+            idle_output = step()
+            if rank == 0:
+                assert idle_output.shape == (0, args.hidden)
+                x, ids, weights = saved, ids_saved, weights_saved
+            else:
+                torch.testing.assert_close(
+                    idle_output,
+                    reference(x, ids, weights, dispatch, combine),
+                    rtol=0.004,
+                    atol=0.003,
+                )
+            torch.cuda.synchronize()
+            dist.barrier()
+            if rank == 0:
+                print(
+                    f"PASS {dispatch} dispatch / {combine} combine: eager, graph replay, idle rank",
+                    flush=True,
+                )
+    del buffer
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
